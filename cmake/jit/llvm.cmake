option(SE_JIT_LLVM_STATIC "Link the LLVM component libraries into the executable instead of depending on the shared libLLVM." OFF)

if(SE_LLVM_PREFIX AND SE_LLVM_IMPLIBS)
    list(GET SE_LLVM_IMPLIBS 0 SE_LLVM_IMPLIB)
    string(REGEX REPLACE "\\.dll\\.a$" ".dll" SE_LLVM_DLL "${SE_LLVM_IMPLIB}")
    get_filename_component(SE_LLVM_DLL_NAME "${SE_LLVM_DLL}" NAME)
    add_library(LLVM SHARED IMPORTED)
    set_target_properties(LLVM PROPERTIES IMPORTED_IMPLIB "${SE_LLVM_IMPLIB}" IMPORTED_LOCATION "${SE_LLVM_PREFIX}/bin/${SE_LLVM_DLL_NAME}")
    target_include_directories(se-interface SYSTEM INTERFACE "${SE_LLVM_PREFIX}/include")
    target_link_libraries(se-interface INTERFACE LLVM)
else()
    find_package(LLVM CONFIG QUIET)
    if(LLVM_FOUND)
        target_include_directories(se-interface SYSTEM INTERFACE ${LLVM_INCLUDE_DIRS})
        if(TARGET LLVM AND NOT SE_JIT_LLVM_STATIC)
            target_link_libraries(se-interface INTERFACE LLVM)
        else()
            llvm_map_components_to_libnames(SE_JIT_LLVM_LIBS core support orcjit passes native)
            target_link_libraries(se-interface INTERFACE ${SE_JIT_LLVM_LIBS})
            if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
                target_link_options(se-interface INTERFACE "LINKER:--as-needed")
            endif()
        endif()
    endif()
endif()
