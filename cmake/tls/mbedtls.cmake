if(NINTENDO_3DS OR NINTENDO_WIIU OR NINTENDO_SWITCH)
    if(NINTENDO_3DS)
        set(_SE_PORTLIBS "${DEVKITPRO}/portlibs/3ds")
    elseif(NINTENDO_SWITCH)
        set(_SE_PORTLIBS "${DEVKITPRO}/portlibs/switch")
    else()
        set(_SE_PORTLIBS "${DEVKITPRO}/portlibs/wiiu")
    endif()
    add_library(se_tls_mbedtls INTERFACE)
    target_link_libraries(se_tls_mbedtls INTERFACE mbedtls mbedx509 mbedcrypto)
    target_include_directories(se_tls_mbedtls INTERFACE "${_SE_PORTLIBS}/include")
    target_link_libraries(se-interface INTERFACE se_tls_mbedtls)
else()
    cl_add_dep(se-interface mbedtls VERSION 3.6)
endif()
target_compile_definitions(se-interface INTERFACE SE_TLS_MBEDTLS)
