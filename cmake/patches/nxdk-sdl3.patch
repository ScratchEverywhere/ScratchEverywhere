+if(NOT EXISTS "${SDL3_DIR}/include/SDL3/SDL.h" OR NOT EXISTS "${SDL3_GLUE_DIR}/render/xgu/xgu.h")
+    message(STATUS "Initializing nxdk-sdl3 git submodules...")
+    execute_process(
+        COMMAND git submodule update --init --recursive
+        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+        RESULT_VARIABLE _submod_res
+    )
+    if(NOT _submod_res EQUAL 0)
+        message(FATAL_ERROR "Failed to initialize submodules in nxdk-sdl3")
+    endif()
+endif()
+
