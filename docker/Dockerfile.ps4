FROM debian:trixie-slim AS main_builder
ENV PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
	build-essential ca-certificates cmake clang lld llvm git pkg-config python3 tar wget

# Download, install and cleanup prebuilt toolchain
RUN wget -O /tmp/sdk.tar.gz "https://github.com/ps4-homebrew-dev/pacbrew/releases/download/v0.4.1/ps4-homebrew-dev.tar.gz" && \
	tar -xzf /tmp/sdk.tar.gz -C / && rm -f /tmp/sdk.tar.gz

# Fetch and install only the Orbis headers
RUN git clone --depth 1 https://github.com/OpenOrbis/OpenOrbis-PS4-Toolchain.git /tmp/openorbis && \
	mkdir -p /opt/ps4-homebrew-sdk/target/include/orbis && \
	cp -r /tmp/openorbis/include/orbis/* /opt/ps4-homebrew-sdk/target/include/orbis && \
	rm -rf /tmp/openorbis

COPY . .

RUN /opt/ps4-homebrew-sdk/bin/orbis-cmake -B build-ps4 -DCMAKE_BUILD_TYPE=Release && cmake --build build-ps4 -j2

FROM scratch AS exporter
COPY --from=main_builder /app/build-ps4/scratch-ps4.pkg /
