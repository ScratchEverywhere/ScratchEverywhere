FROM debian:trixie AS main_builder
ENV CATALOG_NON_INTERACTIVE=1
WORKDIR /app

ARG RENDERER=opengl_core
ARG WINDOWING=win32
ARG AUDIO_ENGINE=winmm
ARG LLVM_INSTALLER=ON

RUN apt-get update && apt-get install -y mingw-w64 mingw-w64-tools wget ca-certificates unzip git pkg-config zip cmake python3 python3-jinja2 nsis libarchive-tools

COPY docker/windows-llvm.sh /usr/local/bin/windows-llvm.sh
RUN if [ "$LLVM_INSTALLER" = "ON" ]; then windows-llvm.sh /opt/msys; fi

COPY . .

RUN --mount=type=secret,id=discord_app_id \
    DISCORD_ARGS=""; \
    if [ -s /run/secrets/discord_app_id ]; then \
        DISCORD_ARGS="-DSE_DISCORD_RPC=ON -DSE_DISCORD_APP_ID=$(tr -d '[:space:]' < /run/secrets/discord_app_id)"; \
    fi; \
    COMMON="${DISCORD_ARGS} -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_SYSTEM_PROCESSOR=x86_64 -DSE_CLOUDVARS=ON -DSE_DOWNLOAD=ON -DCMAKE_BUILD_TYPE=Release -DSE_RENDERER=${RENDERER} -DSE_WINDOWING=${WINDOWING} -DSE_AUDIO_ENGINE=${AUDIO_ENGINE}"; \
    mkdir -p /out && \
    mkdir build && cd build && \
    cmake ${COMMON} -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc -DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++ -DSE_JIT_OPT_BACKEND=none .. && cmake --build . -j 2 && \
    cp scratch-pc.exe /out/ && \
    if [ "$LLVM_INSTALLER" = "ON" ]; then \
        cd .. && mkdir build-llvm && cd build-llvm && \
        cmake ${COMMON} -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc-posix -DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++-posix -DSE_JIT_OPT_BACKEND=llvm -DSE_LLVM_PREFIX=/opt/msys/mingw64 "-DSE_RUNTIME_DLLS=$(cat /opt/msys/runtime-dlls.txt)" .. && \
        cmake --build . -j 2 && cpack && \
        cp scratch-pc-installer.exe /out/; \
    else \
        cpack && cp scratch-pc-installer.exe /out/; \
    fi

FROM scratch AS exporter
COPY --from=main_builder /out/ /
