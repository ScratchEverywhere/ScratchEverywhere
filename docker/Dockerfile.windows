FROM debian:trixie AS main_builder
ENV CATALOG_NON_INTERACTIVE=1
WORKDIR /app

ARG RENDERER=opengl_core
ARG WINDOWING=win32
ARG AUDIO_ENGINE=winmm

RUN apt-get update && apt-get install -y mingw-w64 wget unzip git pkg-config zip cmake python3 python3-jinja2 nsis

COPY . .

RUN --mount=type=secret,id=discord_app_id \
    DISCORD_ARGS=""; \
    if [ -s /run/secrets/discord_app_id ]; then \
        DISCORD_ARGS="-DSE_DISCORD_RPC=ON -DSE_DISCORD_APP_ID=$(tr -d '[:space:]' < /run/secrets/discord_app_id)"; \
    fi; \
    mkdir build && cd build && cmake ${DISCORD_ARGS} -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc -DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++ -DCMAKE_SYSTEM_PROCESSOR=x86_64 -DSE_CLOUDVARS=ON -DSE_DOWNLOAD=ON -DCMAKE_BUILD_TYPE=Release -DSE_RENDERER=${RENDERER} -DSE_WINDOWING=${WINDOWING} -DSE_AUDIO_ENGINE=${AUDIO_ENGINE} .. && cmake --build . -j 2 && cpack

FROM scratch AS exporter
COPY --from=main_builder /app/build/scratch-pc.exe /
COPY --from=main_builder /app/build/scratch-pc-installer.exe /
